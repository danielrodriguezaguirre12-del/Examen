[Unit]
Description=Plataforma de Videos - FastAPI
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/plataforma-videos/backend
EnvironmentFile=/home/ec2-user/plataforma-videos/backend/.env
ExecStart=/home/ec2-user/plataforma-videos/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always

[Install]
WantedBy=multi-user.target
